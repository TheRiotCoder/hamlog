# Response headers for Cloudflare Pages (primary: https://hamlog-azm.pages.dev) and Netlify (same syntax). GitHub Pages ignores this file and
# only gets the <meta> CSP in index.html. Keep the CSP below identical to the <meta> one, plus frame-ancestors (a meta tag can't carry it).
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; manifest-src 'self'; worker-src 'self'; connect-src 'self' https://api.pota.app https://api2.sota.org.uk https://xmldata.qrz.com https://www.hamqth.com https://callook.info; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), publickey-credentials-get=(self), publickey-credentials-create=(self)
  ! Access-Control-Allow-Origin

# (Cloudflare Pages adds 'Access-Control-Allow-Origin: *' to every file by default; the line above removes it)

# the service worker and the shell are always revalidated so a release is picked up at once
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/
  Cache-Control: no-cache
